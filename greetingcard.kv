<CardEditor>:
    padding: dp(15)
    spacing: dp(15)
    canvas.before:
        Color:
            rgba: 0.15, 0.15, 0.18, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        id: preview_container
        orientation: 'vertical'
        size_hint: (1, 1) if root.orientation == 'vertical' else (0.5, 1)

        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'

            BoxLayout:
                size_hint: (None, None)
                size: (preview_container.width, preview_container.width * 1.25) if root.orientation == 'vertical' else (preview_container.height * 0.8, preview_container.height)

                canvas.before:
                    Color:
                        rgba: 1,1,1,1
                    Rectangle:
                        poss: self.pos
                        size: self.size

                Label:
                    text: root.card_text
                    color: 0.2, 0.2, 0.2, 1
                    font_size: sp(28)
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

    ScrollView:
        size_hint: (1, None) if root.orientation == 'vertical' else (0.5, 1)
        height: dp(200) if root.orientation == 'vertical' else self.height

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(10)
            padding: dp(10)

            Label:
                text: "Customise your Card"
                font_size: sp(18)
                size_hint_y: None
                height: dp(30)
                halign: 'left'

            TextInput:
                text: root.card_text
                on_text: root.card_text = self.text
                multiline: False
                size_hint_y: None
                height: dp(45)
                font_size: sp(16)

            Button:
                text: "Export & Share"
                size_hint_y: None
                height: dp(50)
                background_color: 0.2, 0.6, 0.8, 1
                on_release: root.export_card()
